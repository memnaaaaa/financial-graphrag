# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Large raw data (per-dataset .gitignore files handle specific exclusions,
# but ignore any top-level raw data dumps by default)
*.sqlite3
*.db
