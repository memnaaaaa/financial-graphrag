# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Large raw data (per-dataset .gitignore files handle specific exclusions,
# but ignore any top-level raw data dumps by default)
*.sqlite3
*.db

# Phase 2 LLM extraction: cached Gemini answers and the unfinished fin10k_v1 graph stay local for now
data/graph/llm_cache/
data/graph/fin10k_v1/

# LaTeX build files (report/): keep .tex, .bib, figures and the final report PDF only
*.aux
*.bbl
*.blg
*.brf
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
report/prelim_sections.pdf

# Vector-RAG baseline: machine-specific config and the FAISS index cache
vector_rag_baseline/rag/local_config.py
vector_rag_baseline/indexes/
